FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install

FROM node:18-alpine AS runner
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY src/server-v2.js ./src/server.js
RUN chown -R node:node /app
USER node
EXPOSE 8080
CMD ["node", "src/server.js"]
